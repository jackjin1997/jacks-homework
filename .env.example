# Primary provider (default)
LLM_MODEL=google-genai:gemini-2.5-pro
GOOGLE_API_KEY=

# Alternative providers (any can be primary by changing LLM_MODEL)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Summarizer can use a cheaper model
SUMMARIZER_MODEL=google-genai:gemini-2.5-flash

# KB Verifier — uncomment to use cross-model verification (reduces self-judge bias, see spec §5.6 / R6-JUDGE)
# Falls back to SUMMARIZER_MODEL → LLM_MODEL if unset (single-provider 也能跑)
# VERIFIER_MODEL=anthropic:claude-sonnet-4-5

# Eval LLM-as-judge — uncomment to use cross-provider judge (reduces self-bias)
# Falls back to LLM_MODEL if unset
# JUDGE_MODEL=openai:gpt-4o

# Observability (optional but recommended)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=helpdesk-agent
LANGSMITH_TRACING=true
